  {
    "label": "Quarto: Render project",
    "command": "d=\"$ZED_DIRNAME\"; until [ -f \"$d/_quarto.yml\" ] || [ -f \"$d/_quarto.yaml\" ]; do [ \"$d\" = / ] && { echo \"No _quarto.yml in or above $ZED_DIRNAME\"; exit 1; }; d=$(dirname \"$d\"); done; cd \"$d\" && quarto render",
    "reveal": "no_focus",
    "allow_concurrent_runs": true,
    "save": "all"

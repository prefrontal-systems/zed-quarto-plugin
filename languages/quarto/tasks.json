  {
    "label": "Quarto: Convert document to .ipynb",
    "command": "[ ! -e \"$ZED_DIRNAME/$ZED_STEM.ipynb\" ] || { echo \"Not overwriting existing $ZED_STEM.ipynb\"; exit 1; }; quarto convert \"$ZED_FILE\" --output \"$ZED_DIRNAME/$ZED_STEM.ipynb\"",

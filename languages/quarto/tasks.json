    "label": "Quarto: Preview project",
    "command": "d=\"$ZED_DIRNAME\"; until [ -f \"$d/_quarto.yml\" ] || [ -f \"$d/_quarto.yaml\" ]; do [ \"$d\" = / ] && { echo \"No _quarto.yml in or above $ZED_DIRNAME\"; exit 1; }; d=$(dirname \"$d\"); done; cd \"$d\" && quarto preview",
